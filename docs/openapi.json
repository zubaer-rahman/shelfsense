          {
            "name": "productId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "strategy",
            "required": false,
            "in": "query",
            "description": "Forecasting strategy algorithm",
            "schema": {
              "default": "moving_average",
              "type": "string",
              "enum": [
                "naive",
                "moving_average",
                "linear_regression"
              ]
            }
          },
          {
            "name": "window",
            "required": false,
            "in": "query",
            "description": "Historical days lookback window",
            "schema": {
              "minimum": 1,
              "maximum": 365,
              "default": 14,
              "example": 14,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Forecast calculated successfully"
          },
          "404": {
            "description": "Product not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Calculate expected daily demand and reorder suggestion for a product",
        "tags": [
          "Demand Forecasting"
        ]
      }
    },
