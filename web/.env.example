# Backend API URL (server-side only, called by Next.js API proxy)
API_BASE_URL=http://localhost:4000

# Public configurations
NEXT_PUBLIC_APP_NAME=ShelfSense
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_SHOW_DEMO_LOGIN=true

# Demo Quick Sign-in Passwords (server-side only, optional)
DEMO_OWNER_PASSWORD=password123
DEMO_STAFF_PASSWORD=password123
