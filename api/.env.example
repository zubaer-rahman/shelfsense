# Environment mode ('development' or 'production')
NODE_ENV="development"

# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shelfsense?schema=public"

# Authentication
JWT_SECRET="super-secret-development-jwt-key-replace-in-production-123456"
JWT_EXPIRES_IN="7d"

# Server & CORS
PORT=4000
# Single origin, comma-separated list, or wildcard regex (e.g., "http://localhost:3000,https://shelfsense.vercel.app,https://*.vercel.app")
CORS_ORIGIN="http://localhost:3000"

# Inventory & Forecast Tunables
LEAD_TIME_DAYS=7
SAFETY_BUFFER=5
FORECAST_WINDOW_DAYS=14
NEAR_EXPIRY_DAYS=7

# Optional AI / LLM Integration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
